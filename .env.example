# Supabase — buat project baru di https://supabase.com/dashboard, lalu salin
# dari Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opsional — aktifkan fitur "Ringkasan & Saran AI" di dashboard.
# Ambil API key di https://console.anthropic.com/settings/keys
# Kosongkan jika belum mau pakai fitur ini — dashboard tetap jalan normal.
ANTHROPIC_API_KEY=

# Opsional — aktifkan reminder email billing KPR/Kartu Kredit/Pinjaman
# (dikirim otomatis lewat cron harian, lihat vercel.json). Kosongkan salah
# satu atau semuanya untuk menonaktifkan fitur ini sepenuhnya.

# Project Settings → API → "service_role" / "secret" key. RAHASIA — jangan
# pernah dipakai di kode client-side, hanya dibaca dari route server (cron).
SUPABASE_SERVICE_ROLE_KEY=

# Dari https://resend.com — buat API key di Dashboard → API Keys.
RESEND_API_KEY=

# Alamat pengirim email reminder. Default pakai domain testing Resend, yang
# hanya bisa mengirim ke email pemilik akun Resend itu sendiri. Untuk kirim
# ke banyak tester, verifikasi domain sendiri di Resend lalu isi mis.
# "Uangku <reminder@domainkamu.com>".
REMINDER_FROM_EMAIL="Uangku <onboarding@resend.dev>"

# Opsional — kalau diisi, cron route hanya menerima request yang membawa
# header "Authorization: Bearer <CRON_SECRET>" (Vercel mengirim ini otomatis
# untuk cron job kalau env var ini ada). Mencegah orang luar memicu endpoint.
CRON_SECRET=
